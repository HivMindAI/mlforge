# Optional CLI log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
MLFORGE_LOG_LEVEL=WARNING

# Local single-user web workspace. Uploaded CSVs and web metadata are stored here.
MLFORGE_WEB_WORKSPACE=.mlforge-web

# Matches MLForge's default 100 MiB CSV limit.
MLFORGE_WEB_MAX_UPLOAD_BYTES=104857600
